# ---- ElevenLabs (STT + TTS) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# ---- Emotion engine ----
# provider: hume | gemini | stub   (falls back to stub if the chosen key is missing)
EMOTION_PROVIDER=hume
HUME_API_KEY=

# ---- Gemini (emotion fallback + default script writer) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Script generation ----
# provider: gemini | stub
SCRIPT_PROVIDER=gemini

# ---- Tavus (video debrief) ----
TAVUS_API_KEY=
TAVUS_REPLICA_ID=r90bbd427f71
TAVUS_CALLBACK_URL=

# ---- Infra ----
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=
MEDIA_DIR=./media
DEFAULT_USER_ID=demo-user

# ---- Preprocessing tunables (long-conversation path) ----
DIARIZE=true
SILENCE_THRESH_DBFS=-20
MIN_SILENCE_MS=500
HUME_CHUNK_SECONDS=30
